---
import Layout from '~/layouts/PageLayout.astro';

import p1 from '~/assets/images/pedoman-1.png';
import p2 from '~/assets/images/pedoman-2.png';
import p3 from '~/assets/images/pedoman-3.png';
import p4 from '~/assets/images/pedoman-4.png';
import p5 from '~/assets/images/pedoman-5.png';
import p6 from '~/assets/images/pedoman-6.png';
import p7 from '~/assets/images/pedoman-7.png';
import p8 from '~/assets/images/pedoman-8.png';
import p9 from '~/assets/images/pedoman-9.png';
import p10 from '~/assets/images/pedoman-10.png';
import p11 from '~/assets/images/pedoman-11.png';
import p12 from '~/assets/images/pedoman-12.png';
import p13 from '~/assets/images/pedoman-13.png';
import p14 from '~/assets/images/pedoman-14.png';
import p15 from '~/assets/images/pedoman-15.png';
import p16 from '~/assets/images/pedoman-16.png';
import p17 from '~/assets/images/pedoman-17.png';
---

<Layout metadata={{ title: 'Pedoman Visual' }}>
  <section class="max-w-5xl mx-auto px-4 py-16">
    
    <!-- Judul -->
    <h1 class="text-4xl font-bold text-center mb-12">
    </h1>

    <!-- List Gambar -->
    <div class="space-y-10">

      <img src={p1.src} class="w-full rounded-2xl shadow-lg hover:scale-105 transition" />
      <img src={p2.src} class="w-full rounded-2xl shadow-lg hover:scale-105 transition" />
      <img src={p3.src} class="w-full rounded-2xl shadow-lg hover:scale-105 transition" />
      <img src={p4.src} class="w-full rounded-2xl shadow-lg hover:scale-105 transition" />
      <img src={p5.src} class="w-full rounded-2xl shadow-lg hover:scale-105 transition" />
      <img src={p6.src} class="w-full rounded-2xl shadow-lg hover:scale-105 transition" />
      <img src={p7.src} class="w-full rounded-2xl shadow-lg hover:scale-105 transition" />
      <img src={p8.src} class="w-full rounded-2xl shadow-lg hover:scale-105 transition" />
      <img src={p9.src} class="w-full rounded-2xl shadow-lg hover:scale-105 transition" />
      <img src={p10.src} class="w-full rounded-2xl shadow-lg hover:scale-105 transition" />
      <img src={p11.src} class="w-full rounded-2xl shadow-lg hover:scale-105 transition" />
      <img src={p12.src} class="w-full rounded-2xl shadow-lg hover:scale-105 transition" />
      <img src={p13.src} class="w-full rounded-2xl shadow-lg hover:scale-105 transition" />
      <img src={p14.src} class="w-full rounded-2xl shadow-lg hover:scale-105 transition" />
      <img src={p15.src} class="w-full rounded-2xl shadow-lg hover:scale-105 transition" />
      <img src={p16.src} class="w-full rounded-2xl shadow-lg hover:scale-105 transition" />
      <img src={p17.src} class="w-full rounded-2xl shadow-lg hover:scale-105 transition" />

    </div>

  </section>
</Layout>
---
import Favicons from '~/components/Favicons.astro';
---

<html lang="id">
  <head>
    <title>Profil Juri</title>
    <Favicons />
  </head>

  <body>
    <main class="coming-soon">
      <section class="card">
        <h1>Profil Juri</h1>
        <p>Profil juri akan segera tersedia. Nantikan update dari kami.</p>

        <a href="/" class="btn-home">
          Kembali ke Home
        </a>
      </section>
    </main>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: Inter, Arial, Helvetica, sans-serif;
  }

  .coming-soon {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 24px;
    background:
      radial-gradient(circle at 30% 20%, rgba(255, 213, 0, 0.85), transparent 32%),
      linear-gradient(135deg, #ff1400 0%, #ff6a00 45%, #ffd000 100%);
    color: white;
    overflow: hidden;
  }

  .card {
    width: min(720px, 100%);
    text-align: center;
    padding: 64px 38px;
    border-radius: 32px;
    background: rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(14px);
    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.22);
    animation: fadeUp 0.9s ease both;
  }

  .card h1 {
    margin: 0 0 20px;
    font-size: clamp(42px, 6vw, 82px);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .card p {
    margin: 0 auto 34px;
    max-width: 560px;
    font-size: clamp(18px, 2.2vw, 26px);
    font-weight: 600;
    line-height: 1.45;
  }

  .btn-home {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 15px 30px;
    border-radius: 999px;
    color: white;
    text-decoration: none;
    font-weight: 800;
    background: linear-gradient(90deg, #ff1a00, #ff8a00, #ffd000);
    box-shadow: 0 14px 35px rgba(255, 80, 0, 0.35);
    transition: 0.3s ease;
  }

  .btn-home:hover {
    transform: translateY(-5px) scale(1.04);
    box-shadow: 0 20px 45px rgba(255, 80, 0, 0.5);
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(45px) scale(0.96);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (max-width: 640px) {
    .card {
      padding: 48px 24px;
      border-radius: 26px;
    }
  }
</style>
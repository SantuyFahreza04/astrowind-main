---

<html lang="id">
  <head>
    <title>Struktur Panitia</title>
    <Favicons />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800;900&display=swap" rel="stylesheet" />
  </head>

  <body>
    <main class="struktur-page">
      {groups.map((group) => (
        <section class="section">
          <h1 class="title">{group.title}</h1>

          <div class={`grid ${group.people.length === 5 ? 'five' : ''}`}>
            {group.people.map((person, index) => (
              <article class="card" style={`animation-delay:${index * 0.12}s`}>
                <img src={person.img} alt={person.name} />

                <div class="info">
                  <h3>{person.name}</h3>
                  <p>{person.role}</p>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}
    </main>
  </body>
</html>

<style>
  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    font-family: 'Outfit', sans-serif;
  }

  .struktur-page {
  min-height: 100vh;
  color: white;
  overflow-x: hidden;

  background-image: url('bgstrukturpanitia.jpg');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}


  .struktur-page::before {
    width: 1100px;
    height: 720px;
    border: 3px solid rgba(255, 255, 210, 0.85);
    left: 16%;
    top: 8%;
    transform: rotate(-8deg);
    box-shadow: 0 0 18px rgba(255, 255, 150, 0.8);
  }

  .struktur-page::after {
    width: 820px;
    height: 380px;
    border-top: 9px solid rgba(255, 255, 150, 0.75);
    right: 8%;
    top: 34%;
    transform: rotate(-8deg);
    filter: blur(1px);
  }

  .section {
    position: relative;
    z-index: 2;
    padding: 90px 6vw 100px;
  }

  .title {
    text-align: center;
    font-size: clamp(44px, 6vw, 92px);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.00em;
    margin: 0 0 70px;
    animation: titleIn 0.8s ease both;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 45px;
  }

  .five {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .card {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1.13;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.18);
    animation: cardIn 0.85s cubic-bezier(0.16, 1, 0.3, 1) both;
    transition: 0.35s ease;
  }

  .card:hover {
    transform: translateY(-12px) scale(1.035);
    box-shadow: 0 26px 55px rgba(0, 0, 0, 0.28);
  }

  .card img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center top;
  }

  .info {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 72%;
    padding: 12px 10px;
    border-top-right-radius: 28px;
    background: linear-gradient(90deg, #ff1a00 0%, #ff8a00 45%, #ffd600 100%);
  }

  .info h3 {
  margin: 0;
  color: white;
  font-size: 18px;   /* nama */
  font-weight: 800;
  line-height: 1.2;
}

.info p {
  margin: 0;
  color: white;
  font-size: 14px;   /* jabatan */
  font-weight: 600;
}

  @keyframes titleIn {
    from {
      opacity: 0;
      transform: translateY(-35px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes cardIn {
    from {
      opacity: 0;
      transform: translateY(45px) scale(0.92);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (max-width: 900px) {
    .section {
      padding: 70px 28px 80px;
    }

    .title {
      font-size: 56px;
      line-height: 1;
      margin-bottom: 55px;
    }

    .grid,
    .five {
      grid-template-columns: repeat(2, 1fr);
      gap: 34px 28px;
    }

    .five .card:last-child {
      grid-column: 1 / 3;
      width: calc(50% - 14px);
      justify-self: center;
    }

    .card {
      border-radius: 14px;
      aspect-ratio: 1 / 1.12;
    }

    .info {
      width: 74%;
      padding: 9px 8px;
      border-top-right-radius: 24px;
    }

    .info h3 {
      font-size: 10px;
    }

    .info p {
      font-size: 8px;
    }

    .struktur-page::before {
      width: 620px;
      height: 410px;
      left: -18%;
      top: 8%;
    }

    .struktur-page::after {
      width: 520px;
      height: 250px;
      right: -35%;
      top: 30%;
    }
  }

  @media (max-width: 420px) {
    .section {
      padding: 62px 22px 72px;
    }

    .title {
      font-size: 48px;
      margin-bottom: 42px;
    }

    .grid,
    .five {
      gap: 26px 20px;
    }

    .info {
      width: 78%;
      padding: 8px 7px;
    }

    .info h3 {
      font-size: 9px;
    }

    .info p {
      font-size: 7px;
    }
  }
  
  @media (max-width: 1200px) {
  .grid,
  .five {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    gap: 34px 28px;
  }

  .card {
  height: auto;
  aspect-ratio: 1 / 1.13;
}
}

</style>
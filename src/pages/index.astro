---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'V-FEST 2026',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

 <Hero
  actions={[
    {
      variant: 'primary',
      text: 'Daftar Sekarang',
      href: '/pendaftaran',
    },
    {
      text: 'Lihat Juknis',
      href: 'https://drive.google.com/file/d/ABC123/view?usp=sharing',
      target: '_blank',
    },
  ]}
  image={{ src: '~/assets/images/vfest-hero.png', alt: 'V-FEST Image' }}
>
  <Fragment slot="title">
    Visual Creativity Festival
  </Fragment>

  <Fragment slot="subtitle">
    Dari Satu Langkah Karya Menggema Seribu Makna.
  </Fragment>
</Hero>

<!-- LOADING SCREEN -->
<div
  id="loadingScreen"
  class="fixed inset-0 z-[9999] hidden items-center justify-center bg-white"
>
  <div class="text-center">

    <!-- SPINNER + LOGO -->
    <div class="relative mx-auto mb-4 w-24 h-24">

      <!-- BULATAN LOADING -->
      <div class="absolute inset-0 animate-spin rounded-full border-4 border-red-600 border-t-yellow-300"></div>

      <!-- LOGO DI TENGAH -->
      <img
        src="logoloading.png"
        alt="Logo"
        class="absolute top-1/2 left-1/2 w-12 h-12 object-contain logo-anim"
      />

    </div>

    <!-- TEXT -->
    <p class="text-xl font-semibold bg-gradient-to-r from-red-600 via-amber-400 to-yellow-300 bg-clip-text text-transparent">
      Loading...
    </p>

  </div>
</div>

<!-- SCRIPT -->
<script>
  const daftarBtn = document.querySelector('a[href="/pendaftaran"]');
  const loadingScreen = document.getElementById('loadingScreen');

  daftarBtn?.addEventListener('click', function (e) {
    e.preventDefault();

    loadingScreen?.classList.remove('hidden');
    loadingScreen?.classList.add('flex');

    setTimeout(() => {
      window.location.href = '/pendaftaran';
    }, 1200);
  });
</script>

<!-- ANIMASI LOGO -->
<style>
  @keyframes logoAnim {
    0% {
      transform: translate(-50%, -50%) scale(0.7);
      opacity: 0;
    }

    50% {
      transform: translate(-50%, -50%) scale(1.1);
      opacity: 1;
    }

    100% {
      transform: translate(-50%, -50%) scale(1);
      opacity: 1;
    }
  }

  .logo-anim {
    animation: logoAnim 1s ease forwards;
  }
</style>

  <!-- Tema Besar -->
<section class="text-center mt-16 max-w-4xl mx-auto px-4">
  <h2 class="text-4xl font-bold mb-6">Tema Besar</h2>

  <p class="text-lg leading-relaxed text-gray-700">
    Dari satu langkah karya, menggema seribu makna. Tema ini menegaskan bahwa setiap karya,
    sekecil apa pun langkah awalnya, memiliki potensi untuk melahirkan dampak yang luas dan berlapis.
    “Satu langkah karya” merepresentasikan keberanian untuk memulai sebuah proses sederhana ketika ide,
    rasa, dan sudut pandang dituangkan ke dalam bentuk visual.
  </p>

  <p class="text-lg leading-relaxed text-gray-700 mt-4">
    Menggema seribu makna menggambarkan bagaimana sebuah karya tidak berhenti pada satu tafsir.
    Ia berkembang, menyentuh banyak sudut pandang, dan membuka ruang interpretasi yang luas bagi setiap orang.
    Satu visual dapat menghadirkan beragam rasa, menginspirasi, menggugah, bahkan mengubah cara seseorang memaknai kehidupan.
  </p>

  <p class="text-lg leading-relaxed text-gray-700 mt-4">
    Jadi tema ini mengandung harapan bahwa setiap peserta berani mengambil langkah awal dalam berkarya,
    karena dari langkah sederhana tersebut dapat lahir gema makna yang tak terbatas dan berdampak luas.
  </p>
</section>

<section class="max-w-5xl mx-auto px-4 py-16 space-y-16">

  <a href="/fotografi" class="block">
    <img
      src="/tema-fotografi.png"
      alt="Tema Fotografi"
      class="w-full aspect-[16/7] object-cover rounded-2xl shadow-lg"
    />
  </a>

  <a href="/desain" class="block">
    <img
      src="/tema-desain.png"
      alt="Tema Desain Grafis"
      class="w-full aspect-[16/7] object-cover rounded-2xl shadow-lg"
    />
  </a>

  <a href="/vlog" class="block">
    <img
      src="/tema-video.png"
      alt="Tema Video Vlog"
      class="w-full aspect-[16/7] object-cover rounded-2xl shadow-lg"
    />
  </a>

</section>
</a>


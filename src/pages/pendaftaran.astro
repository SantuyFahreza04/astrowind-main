<Layout metadata={{ title: 'Pendaftaran V-FEST 2026' }}>
  <section class="max-w-5xl mx-auto px-4 py-16">

    <!-- Judul -->
    <h1 class="text-4xl font-bold text-center mb-4">
      Pendaftaran Lomba

    <p class="text-center mb-10 text-gray-600">
      Pilih lomba yang ingin kamu ikuti
    </p>

    <!-- Card -->
    <div class="grid md:grid-cols-3 gap-6">

      <!-- Fotografi -->
      <a
        href="/comingsoon"
        class="border p-6 rounded-xl text-center hover:shadow-lg transition"
      >
        <span class="text-lg font-semibold">📷 Fotografi</span>
      </a>

      <!-- Desain Grafis -->
